default_platform(:ios)

def tuist_generate
  Dir.chdir("..") do
    sh "tuist install"
    sh "tuist generate --no-open"
  end
end

platform :ios do
  # Team ID 환경변수에서 가져오기
  team_id = ENV.fetch("COSMIC_TEAM_ID", "YOUR_TEAM_ID")
  app_identifier = "kr.boostcamp10.ios05.cosmic-adventure"

  desc "Match로 인증서/프로파일 동기화 (readonly)"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: true,
      app_identifier: app_identifier
    )
  end

  desc "TestFlight에 업로드"
  lane :upload_testflight do
    tuist_generate

    # Match로 인증서 동기화 (CI 환경에서)
    if ENV["CI"]
      sync_certificates
    end

    # Extract version from tag (ios-v1.2.3 -> 1.2.3)
    ref = ENV.fetch("GITHUB_REF", "refs/tags/ios-v0.0.0")
    m = ref.match(%r{^refs/tags/ios-v(\d+\.\d+\.\d+)})
    UI.user_error!("Invalid tag format: #{ref}") unless m
    marketing_version = m[1]

    # Build number from CI
    if ENV["GITHUB_RUN_NUMBER"]
      run_number = ENV.fetch("GITHUB_RUN_NUMBER").to_i
      run_attempt = ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_i
      build_number = (run_number * 10) + run_attempt
    else
      build_number = Time.now.strftime("%y%m%d%H%M").to_i
    end

    UI.message("Building version #{marketing_version} (#{build_number})")

    # Match 사용 시 프로파일 이름 가져오기
    profile_name = ENV["sigh_#{app_identifier}_appstore_profile-name"] || ENV.fetch("APP_STORE_PROVISIONING_PROFILE_NAME", "")

    # App 타겟만 Manual signing으로 변경 (프레임워크 모듈은 건드리지 않음)
    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: team_id,
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      targets: ["App"],
      path: "iOS/App/App.xcodeproj"
    )

    gym(
      workspace: "cosmic-adventure.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      skip_profile_detection: true,
      xcargs: [
        "MARKETING_VERSION=#{marketing_version}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{team_id}"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          app_identifier => profile_name
        }
      }
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: "fastlane/AuthKey.p8",
      in_house: false
    )

    pilot(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
